# Copy to .env for local development. Never commit .env.
# Placeholders only. Real secrets live in the secret manager (see ADR-007).

APP_ENV=local
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# Database (local docker-compose)
DATABASE_URL=postgresql+psycopg://veltrix_app:CHANGE_ME@localhost:5432/veltrix
DATABASE_MIGRATION_URL=postgresql+psycopg://veltrix_owner:CHANGE_ME@localhost:5432/veltrix

# Auth (ADR-003)
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
MFA_ISSUER=Veltrix

# File storage (ADR-006, MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=veltrix-local
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_ENABLED=false

# Solve workers (ADR-002, ADR-005)
SOLVE_DEFAULT_TIME_LIMIT_SECONDS=120
SOLVE_DEFAULT_MEMORY_MB=2048
SOLVE_MAX_CONCURRENT_PER_ORG=2

# Feature flags
ENGINE_PRODUCTION_ENABLED=true
ENGINE_TRANSPORTATION_ENABLED=false
ENGINE_INVENTORY_ENABLED=false

# Local docker-compose passwords (read by docker-compose.yml)
DATABASE_APP_PASSWORD=CHANGE_ME
DATABASE_OWNER_PASSWORD=CHANGE_ME

# Logging, health and worker
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
